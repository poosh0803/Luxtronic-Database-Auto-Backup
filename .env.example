# ---------------------------------------------------------------------------
# Luxtronic Database Auto Backup
# Copy to .env and fill in the passwords. .env is gitignored - never commit it.
# ---------------------------------------------------------------------------

# Port the status page listens on.
PORT=7999

# --- Where and when -------------------------------------------------------
# Backups hold real customer data. Ideally point this at a different disk/machine
# than the one the databases live on (e.g. a NAS share: \\NAS\luxtronic-backups).
BACKUP_DIR=./backups

# Standard 5-field cron. Default: every day at 2:00 AM.
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=Australia/Sydney

# Delete backups older than this many days, but always keep the newest
# BACKUP_KEEP_MIN per database, however old, so an outage can't wipe the last good copies.
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3

# The status page flags a database "stale" when its newest backup is older than this.
BACKUP_STALE_HOURS=36

# Kill a single database dump that runs longer than this.
BACKUP_TIMEOUT_MINUTES=60

# --- How dumps are made ----------------------------------------------------
# auto   = use a local pg_dump if installed, otherwise run pg_dump in a Docker container
# local  = only local pg_dump (PG_DUMP_PATH)
# docker = only Docker (PG_DOCKER_IMAGE)
# pg_dump must be the same version as the servers or newer - the servers run Postgres 17.
PG_DUMP_MODE=auto
PG_DUMP_PATH=pg_dump
PG_DOCKER_IMAGE=postgres:17

# --- Database servers ------------------------------------------------------
# Credentials shared by most servers. Any server can override them with
# DB_<NAME>_HOST / _PORT / _USER / _PASSWORD.
DB_DEFAULT_HOST=192.168.68.222
DB_DEFAULT_USER=luxtronic_user
DB_DEFAULT_PASSWORD=

# One entry per Postgres server (host:port). Every database found on a server is
# backed up automatically - no need to list database names.
DB_TARGETS=quotation,service-form,pctools,rental,service-neo

# Each target needs at least a port. Names map to variables as upper-case with
# "-" turned into "_": target "service-form" -> DB_SERVICE_FORM_PORT.
# Optional per target: DB_<NAME>_LABEL (display name), DB_<NAME>_DATABASES
# (comma list to back up only some databases instead of all).
DB_QUOTATION_PORT=5432
DB_QUOTATION_LABEL=Quotation Form

DB_SERVICE_FORM_PORT=5433
DB_SERVICE_FORM_LABEL=Service Form

DB_PCTOOLS_PORT=5434
DB_PCTOOLS_LABEL=PC Tools

DB_RENTAL_PORT=5435
DB_RENTAL_LABEL=Rental

DB_SERVICE_NEO_PORT=5436
DB_SERVICE_NEO_LABEL=Service NEO

# To add another database server later:
#   1. add its name to DB_TARGETS, e.g. DB_TARGETS=...,warranty
#   2. add DB_WARRANTY_PORT=5437 (plus _HOST/_USER/_PASSWORD if they differ)
#   3. pm2 restart luxtronic-db-backup
